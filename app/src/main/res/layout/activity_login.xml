<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- IMAGEN DE FONDO (El Geco) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_terrario"
        android:scaleType="centerCrop" />

    <!-- PANEL CENTRAL (Estilo Cristal) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:background="@drawable/bg_panel_cristal"
        android:orientation="vertical"
        android:padding="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TerraMonitor"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Acceso de Seguridad"
            android:textAlignment="center"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/etUsuario"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_cristal"
            android:hint="Nombre de Usuario"
            android:textColorHint="#E0E0E0"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:textColor="#FFFFFF"/>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_cristal"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:textColorHint="#E0E0E0"
            android:padding="12dp"
            android:layout_marginBottom="24dp"
            android:textColor="#FFFFFF"/>

        <!-- BOTÓN CON EFECTO TRANSLÚCIDO -->
        <Button
            android:id="@+id/btnIngresar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="#B3FF5722"
            android:text="Ingresar al Terrario"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>